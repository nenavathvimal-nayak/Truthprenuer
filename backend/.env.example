# Environment Mode: development | staging | production
ENVIRONMENT=development

# Server Configuration
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins
ALLOWED_ORIGINS=["https://truthprenuer.pages.dev","https://admin-truthprenuer.pages.dev","http://localhost:5173","http://localhost:3000","http://localhost:8080"]

# Supabase Infrastructure (Server-side service credentials)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-super-privileged-service-role-key-never-share-with-clients
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-for-verifying-tokens

# Gemini AI Engine (Server-side held)
GEMINI_API_KEY=your-gemini-api-key

# Rate Limiting Guardrails
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=10
