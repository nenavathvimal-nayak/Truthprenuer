# Explicit MIME types and caching for crawlers and sitemaps
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=86400

# Immutable long-term caching for static fonts and engine binaries
/canvaskit/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache compiled JS and WASM for fast reload and instant restore
/*.js
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.wasm
  Cache-Control: public, max-age=31536000, immutable

# Security and cache-control headers for all html/page requests
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: public, max-age=0, must-revalidate
