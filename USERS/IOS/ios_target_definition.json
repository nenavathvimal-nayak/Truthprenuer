{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "platform": "ios",
  "application": "Truthprenuer Client iOS",
  "canonicalRoot": "ios/",
  "bundleIdentifier": "com.truthprenuer.ios",
  "minIosVersion": "13.0",
  "runner": "ios/Runner.xcodeproj",
  "workspace": "ios/Runner.xcworkspace",
  "infoPlist": "ios/Runner/Info.plist",
  "podfile": "ios/Podfile",
  "signing": {
    "developmentTeam": "",
    "codeSignIdentity": "Apple Development"
  },
  "buildCommands": {
    "debug": "flutter run -d ios",
    "ipa": "flutter build ipa --release"
  }
}
